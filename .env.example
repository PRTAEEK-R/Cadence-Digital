# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# --- CADENCE DIGITAL PERSISTENCE & INTEGRATIONS ---

# SUPABASE_URL: Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Secure server-side service role key for inquiries table
SUPABASE_SERVICE_ROLE_KEY=""

# SUPABASE_ANON_KEY: Alternative public client key
SUPABASE_ANON_KEY=""

# RESEND_API_KEY: Optional Resend key for sending email notifications on new client leads
RESEND_API_KEY=""

# NOTIFICATION_EMAIL: Target email address for team alert notifications
NOTIFICATION_EMAIL="team@cadencedigital.agency"
